#!/bin/sh
# cv: build tailored one-page CVs from a master profile. Run "cv --help".
# Resolves its own location (also through a symlink) and leaves the working directory alone,
# so relative paths given on the command line keep working.
self=$(readlink -f "$0" 2>/dev/null || echo "$0")
root=$(cd "$(dirname "$self")/.." && pwd -P)
PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m cvbuild "$@"
